@import url('https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&family=Bebas+Neue&family=Caveat:wght@400;700&family=BenchNine:wght@700&family=Handlee&display=swap');
@import "tailwindcss";

@theme {
  /* ============================================
     Aurora Design System — Design Tokens
     Source: Figma (Aurora App Design System)
     ============================================ */

  /* --- Brand Colors --- */
  --color-curefit-yellow: #F5BC00;
  --color-curefit-yellow-light: #FFDC18;
  --color-curefit-pink: #FF3278;
  --color-curefit-blue: #00BEFF;
  --color-curefit-green: #0FE498;

  /* --- Semantic / Alias Colors --- */
  --color-dark-primary: #1C1C1E;
  --color-dark-secondary: #2C2C2C;
  --color-dark-ink: #141515;
  --color-dark-action: #333333;
  --color-light-primary: #FFFFFF;
  --color-light-action: #F0F0F0;

  /* --- Status Colors --- */
  --color-status-positive: #4AB74A;
  --color-status-negative: #B00020;
  --color-status-alert: #F5BC00;
  --color-status-neutral: #00BEFF;

  /* --- Text Colors --- */
  --color-text-white: #FFFFFF;
  --color-text-dark: #313028;
  --color-text-1: #FFFFFF;
  --color-text-2: #999CA0;
  --color-text-disabled: rgba(255, 255, 255, 0.1);

  /* --- Surface / Background Colors --- */
  --color-bg-dark: #1A1A1A;
  --color-bg-card: #1C1C1E;
  --color-bg-elevated: #2C2C2C;
  --color-bg-surface: #232323;
  --color-card-bg: #F4F0E6;

  /* --- Gray Scale --- */
  --color-gray-white: #FFFFFF;
  --color-gray-50: #F7F7F7;
  --color-gray-100: #F0F0F0;
  --color-gray-200: #E0E0E0;
  --color-gray-300: #D9D9D9;
  --color-gray-400: #C4C4C4;
  --color-gray-500: #999CA0;
  --color-gray-600: #808080;
  --color-gray-700: #666666;
  --color-gray-800: #434343;
  --color-gray-900: #2C2C2C;
  --color-gray-dark: #1C1C1E;

  /* --- Opacity Variants --- */
  --color-white-10: rgba(255, 255, 255, 0.1);
  --color-white-20: rgba(255, 255, 255, 0.2);
  --color-white-40: rgba(255, 255, 255, 0.4);
  --color-white-60: rgba(255, 255, 255, 0.6);

  /* --- Accent (legacy project tokens) --- */
  --color-accent-purple: #7F5BFF;
  --color-line-gray: #B3B3B3;

  /* --- Additional Accent Colors --- */
  --color-orange: #FF9700;
  --color-coral: #FF5942;
  --color-gold: #F7C744;
  --color-blue: #3888FF;

  /* ============================================
     ENHANCEMENT TOKENS — Added from Global Dev Handoff
     Non-destructive additions. Existing tokens above remain intact.
     ============================================ */

  /* --- Semantic Color Roles (Aurora + Handoff) --- */
  --color-scrim: rgba(0, 0, 0, 0.6);              /* modal scrim behind sheets */
  --color-overlay: rgba(0, 0, 0, 0.4);            /* image/video overlay */
  --color-divider: rgba(255, 255, 255, 0.1);      /* hairline divider on dark */
  --color-divider-light: rgba(0, 0, 0, 0.08);     /* hairline divider on light */
  --color-focus-ring: #00BEFF;                    /* keyboard focus */

  /* --- Interactive State Tokens --- */
  --state-disabled-opacity: 0.4;
  --state-disabled-bg: rgba(255, 255, 255, 0.1);
  --state-selected-bg: rgba(245, 188, 0, 0.12);   /* curefit-yellow @ 12% */
  --state-pressed-bg: rgba(255, 255, 255, 0.08);
  --state-hover-bg: rgba(255, 255, 255, 0.04);

  /* ============================================
     CTA System — sourced from Figma Aurora App Design System
     (file jD7tZtVeQCMRlIHN7L8umI — Buttons page)

     RULE: CTA colors are strictly white + coral (#FF5942) + white-glass.
     NEVER use curefit-yellow or curefit-blue on an interactive button.

     Hierarchy:
       Primary   — highest priority. White bg, coral text. Solid + outline variants.
       Secondary — SKU / banner buttons. Glass (20% white + 10px blur), white text.
                   Rich state variants: booked / waitlist / waitlisted / full / negative.
       Tertiary  — plain 14px bold ALL CAPS white label. No container.
       Twins     — double-CTA pattern (50px or 40px height, min-width 135px each).
     ============================================ */

  /* --- Primary CTA --- */
  --cta-primary-bg: #FFFFFF;
  --cta-primary-text: #FF5942;                    /* coral, not pink */
  --cta-primary-border: transparent;
  --cta-primary-radius: 8px;
  --cta-primary-min-width: 120px;
  --cta-primary-max-width: 335px;
  --cta-primary-height: 44px;
  --cta-primary-bg-hover: #FFF1EE;
  --cta-primary-bg-pressed: #FFE1DB;
  --cta-primary-shadow: 0 4px 14px rgba(255, 89, 66, 0.22);

  /* Primary — outline variant */
  --cta-primary-outline-bg: transparent;
  --cta-primary-outline-text: #FF5942;
  --cta-primary-outline-border: #FFFFFF;

  /* Primary — disabled */
  --cta-primary-disabled-bg: #2C2C2C;             /* color-bg-elevated */
  --cta-primary-disabled-text: rgba(255, 255, 255, 0.4);
  --cta-primary-disabled-border: transparent;
  --cta-primary-disabled-outline-border: rgba(255, 255, 255, 0.2);

  /* --- Secondary CTA (glass) --- */
  --cta-secondary-bg: rgba(255, 255, 255, 0.20);  /* 20% opacity white */
  --cta-secondary-backdrop-blur: 10px;            /* figma: 10px blur */
  --cta-secondary-text: #FFFFFF;
  --cta-secondary-border: transparent;
  --cta-secondary-radius: 8px;
  --cta-secondary-min-width: 120px;
  --cta-secondary-height: 40px;
  --cta-secondary-bg-hover: rgba(255, 255, 255, 0.28);
  --cta-secondary-bg-pressed: rgba(255, 255, 255, 0.14);

  /* Secondary — state variants */
  --cta-secondary-active-bg: rgba(255, 255, 255, 0.20);
  --cta-secondary-disabled-bg: rgba(255, 255, 255, 0.08);
  --cta-secondary-disabled-text: rgba(255, 255, 255, 0.4);
  --cta-secondary-booked-bg: rgba(74, 183, 74, 0.18);        /* status-positive tint */
  --cta-secondary-booked-text: #4AB74A;
  --cta-secondary-waitlist-bg: rgba(247, 199, 68, 0.18);     /* gold/alert tint */
  --cta-secondary-waitlist-text: #F7C744;
  --cta-secondary-waitlisted-bg: rgba(74, 183, 74, 0.18);
  --cta-secondary-waitlisted-text: #4AB74A;
  --cta-secondary-full-bg: rgba(255, 255, 255, 0.08);
  --cta-secondary-full-text: rgba(255, 255, 255, 0.4);
  --cta-secondary-negative-bg: rgba(176, 0, 32, 0.12);
  --cta-secondary-negative-text: #FF5942;                     /* coral text for negative */

  /* --- Tertiary CTA (plain text) --- */
  --cta-tertiary-bg: transparent;
  --cta-tertiary-text: #FFFFFF;
  --cta-tertiary-border: transparent;
  --cta-tertiary-font-size: 14px;
  --cta-tertiary-font-weight: 700;
  --cta-tertiary-letter-spacing: 0.5px;
  --cta-tertiary-padding-x: 12px;
  --cta-tertiary-padding-y: 8px;
  --cta-tertiary-disabled-text: rgba(255, 255, 255, 0.4);

  /* --- Twins (double CTA row) --- */
  --cta-twins-gap: 10px;
  --cta-twins-min-width: 135px;
  --cta-twins-height-lg: 50px;
  --cta-twins-height-sm: 40px;

  /* --- Shared CTA typography (matches Figma Buttons spec) --- */
  --cta-font-family: var(--font-primary);
  --cta-font-weight: 700;
  --cta-font-size: 14px;
  --cta-letter-spacing: 0.5px;
  --cta-text-transform: uppercase;

  /* --- Font Families --- */
  --font-primary: "Inter", "Helvetica Neue", "Arial", sans-serif;
  --font-display: "Bw Modelica SS01", "Inter", sans-serif;
  --font-mono: "Roboto Mono", monospace;
  --font-bebas: "Bebas Neue", sans-serif;
  --font-heading: "Helvetica Neue", "Helvetica", "Arial", sans-serif;
  --font-handwritten: "Caveat", "Segoe Script", cursive;
  --font-handlee: "Handlee", "Caveat", cursive;    /* new handwritten accent */
  --font-label: "BenchNine", "Arial Narrow", sans-serif;

  /* --- Typography Scale (Aurora type tokens as CSS vars) ---
     Each token exposes size, weight, line-height, letter-spacing.
     Use via: font-size: var(--text-h1-size); etc.
  */
  /* Headings */
  --text-h1-size: 20px;   --text-h1-weight: 700; --text-h1-lh: 1.4; --text-h1-ls: -0.2px;
  --text-h2-size: 18px;   --text-h2-weight: 700; --text-h2-lh: 1.4; --text-h2-ls: -0.2px;
  --text-h3-size: 18px;   --text-h3-weight: 500; --text-h3-lh: 1.4; --text-h3-ls: -0.2px;
  --text-h4-size: 16px;   --text-h4-weight: 700; --text-h4-lh: 1.4; --text-h4-ls: -0.1px;
  --text-h5-size: 50px;   --text-h5-weight: 900; --text-h5-lh: 1.0; --text-h5-ls: -2.5px;
  --text-h7-size: 38px;   --text-h7-weight: 900; --text-h7-lh: 1.05; --text-h7-ls: -1.6px;
  --text-h8-size: 35px;   --text-h8-weight: 500; --text-h8-lh: 1.1; --text-h8-ls: -1.0px;
  --text-h9-size: 24px;   --text-h9-weight: 800; --text-h9-lh: 1.2; --text-h9-ls: -0.5px;
  --text-h10-size: 30px;  --text-h10-weight: 700; --text-h10-lh: 1.15; --text-h10-ls: -0.8px;

  /* Body & paragraph */
  --text-p1-size: 16px;   --text-p1-weight: 500; --text-p1-lh: 1.5; --text-p1-ls: 0;
  --text-p2-size: 16px;   --text-p2-weight: 400; --text-p2-lh: 1.5; --text-p2-ls: 0;
  --text-p3-size: 14px;   --text-p3-weight: 700; --text-p3-lh: 1.5; --text-p3-ls: 0;
  --text-p4-size: 14px;   --text-p4-weight: 500; --text-p4-lh: 1.5; --text-p4-ls: 0;
  --text-p5-size: 14px;   --text-p5-weight: 400; --text-p5-lh: 1.5; --text-p5-ls: 0;
  --text-p6-size: 12px;   --text-p6-weight: 700; --text-p6-lh: 1.4; --text-p6-ls: 2.4px;  /* ALL CAPS label */
  --text-p8-size: 12px;   --text-p8-weight: 400; --text-p8-lh: 1.4; --text-p8-ls: 0;
  --text-p10-size: 10px;  --text-p10-weight: 400; --text-p10-lh: 1.3; --text-p10-ls: 0;

  /* CTA + Tag */
  --text-cta-size: 14px;  --text-cta-weight: 700; --text-cta-lh: 1.0; --text-cta-ls: 1.4px;
  --text-tag-size: 10px;  --text-tag-weight: 700; --text-tag-lh: 1.2; --text-tag-ls: 1.0px;

  /* --- Spacing Scale (5px rhythm) --- */
  --spacing-1: 5px;
  --spacing-2: 10px;
  --spacing-3: 15px;
  --spacing-4: 20px;
  --spacing-5: 24px;
  --spacing-6: 30px;
  --spacing-8: 40px;
  --spacing-10: 50px;
  --spacing-12: 60px;
  --spacing-16: 80px;
  --spacing-20: 100px;
  --spacing-30: 150px;

  /* --- Border Radius Scale --- */
  --radius-2xs: 5px;     /* tight chip radius */
  --radius-xs: 4px;
  --radius-sm: 8px;
  --radius-card: 10px;   /* standard card radius (Handoff) */
  --radius-md: 12px;
  --radius-chip: 15px;   /* chip / segmented control */
  --radius-lg: 16px;
  --radius-xl: 20px;
  --radius-2xl: 30px;
  --radius-3xl: 40px;
  --radius-pill: 50px;   /* pill button */
  --radius-avatar: 100px; /* circular avatars */
  --radius-full: 1000px;

  /* --- Backdrop Blur Scale ---
     Extended from the original weak/medium/strong trio. Named scale (xs-3xl + full)
     for ergonomic use; legacy names are aliased so existing code keeps working.
  */
  --blur-xs: 4px;
  --blur-sm: 10px;
  --blur-md: 30px;
  --blur-lg: 80px;
  --blur-xl: 120px;
  --blur-2xl: 160px;
  --blur-3xl: 200px;
  --blur-full: 300px;       /* for aurora-bg drifting blobs */
  /* Legacy aliases — do not remove, kept for backward compat */
  --blur-weak: 10px;
  --blur-medium: 30px;
  --blur-strong: 80px;

  /* ============================================
     Aurora Animated Background
     Three slow-drifting blobs (pink, yellow, blue) with full blur.
     Applied via the .aurora-bg utility class. Tokens are configurable.
     ============================================ */
  --aurora-bg-blob-pink: #FF3278;
  --aurora-bg-blob-yellow: #F5BC00;
  --aurora-bg-blob-blue: #00BEFF;
  --aurora-bg-blob-opacity: 0.35;
  --aurora-bg-blob-size: 45vw;
  --aurora-bg-blob-blur: var(--blur-3xl);      /* 200px */
  --aurora-bg-duration-pink: 24s;
  --aurora-bg-duration-yellow: 32s;
  --aurora-bg-duration-blue: 28s;
  --aurora-bg-easing: cubic-bezier(0.45, 0.05, 0.55, 0.95);

  /* --- Motion Tokens --- */
  --duration-instant: 0ms;
  --duration-fast: 120ms;
  --duration-normal: 200ms;
  --duration-slow: 320ms;
  --duration-slower: 480ms;
  --easing-linear: cubic-bezier(0, 0, 1, 1);
  --easing-in: cubic-bezier(0.4, 0, 1, 1);
  --easing-out: cubic-bezier(0, 0, 0.2, 1);
  --easing-default: cubic-bezier(0.4, 0, 0.2, 1);
  --easing-spring: cubic-bezier(0.34, 1.56, 0.64, 1);

  /* --- Z-Index Scale --- */
  --z-base: 0;
  --z-dropdown: 100;
  --z-sticky: 200;
  --z-overlay: 300;
  --z-modal: 400;
  --z-toast: 500;
  --z-tooltip: 600;

  /* --- Shadow Scale --- */
  --shadow-subtle: 0px 2px 6px rgba(0, 0, 0, 0.07);
  --shadow-low: 0px 4px 11px rgba(0, 0, 0, 0.15);
  --shadow-medium: 0px 4px 14px rgba(0, 0, 0, 0.25);
  --shadow-high: 0px 13px 24px rgba(0, 0, 0, 0.22);
  --shadow-floating: 0px 4px 25px rgba(0, 0, 0, 0.15);
  --shadow-modal: 0px 14px 24px 3px rgba(0, 0, 0, 0.25);
  --shadow-divider: 0px 1px 0px rgba(0, 0, 0, 0.3);
  --shadow-focus: 0 0 0 3px rgba(0, 190, 255, 0.4);

  /* --- Elevation System (surface + shadow pairs) ---
     Use these on cards/sheets/modals for consistent depth.
  */
  --elevation-0-bg: var(--color-bg-dark);
  --elevation-1-bg: var(--color-bg-card);
  --elevation-1-shadow: var(--shadow-subtle);
  --elevation-2-bg: var(--color-bg-elevated);
  --elevation-2-shadow: var(--shadow-low);
  --elevation-3-bg: var(--color-bg-elevated);
  --elevation-3-shadow: var(--shadow-medium);
  --elevation-4-bg: var(--color-bg-elevated);
  --elevation-4-shadow: var(--shadow-high);
  --elevation-modal-bg: var(--color-bg-elevated);
  --elevation-modal-shadow: var(--shadow-modal);

  /* --- Gradient Tokens (from Handoff) --- */
  --gradient-aurora-sky: linear-gradient(225deg, #F5BC00 0%, #00BEFF 100%);
  --gradient-fading-stroke: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.2) 50%, rgba(255,255,255,0) 100%);
  --gradient-purple-glow: radial-gradient(circle, rgba(127,91,255,0.5) 0%, rgba(127,91,255,0) 70%);
  --gradient-yellow-pink: linear-gradient(135deg, #F5BC00 0%, #FF3278 100%);
  --gradient-scrim-bottom: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.8) 100%);
}

body {
  margin: 0;
  display: flex;
  place-items: center;
  justify-content: center;
  min-height: 100vh;
  background-color: var(--color-bg-dark);
  font-family: var(--font-primary);
  color: var(--color-text-white);
  /* Aurora animated background applied globally */
  position: relative;
  overflow-x: hidden;
}

#root {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 0;
  position: relative;
  z-index: 1;
}

/* ============================================
   Aurora Background — three drifting blurred blobs
   Usage: <div class="aurora-bg">…</div> or applied to body::before/::after.
   Reduced-motion: animation paused for users who prefer it.
   ============================================ */

body::before,
body::after,
.aurora-bg-blob {
  content: "";
  position: fixed;
  top: 50%;
  left: 50%;
  width: var(--aurora-bg-blob-size);
  height: var(--aurora-bg-blob-size);
  border-radius: 50%;
  filter: blur(var(--aurora-bg-blob-blur));
  opacity: var(--aurora-bg-blob-opacity);
  pointer-events: none;
  z-index: 0;
  will-change: transform;
}

/* Pink blob — top-left drift */
body::before {
  background: var(--aurora-bg-blob-pink);
  animation: aurora-drift-pink var(--aurora-bg-duration-pink) var(--aurora-bg-easing) infinite;
}

/* Yellow blob — bottom-right drift, offset phase */
body::after {
  background: var(--aurora-bg-blob-yellow);
  animation: aurora-drift-yellow var(--aurora-bg-duration-yellow) var(--aurora-bg-easing) infinite;
  animation-delay: -8s;
}

/* Blue blob — requires a real DOM element (see .aurora-bg utility below) because
   CSS only gives us ::before + ::after. Apply .aurora-bg to a container for all three. */

.aurora-bg {
  position: relative;
  overflow: hidden;
  isolation: isolate;
}

.aurora-bg > .aurora-bg-blob--pink {
  background: var(--aurora-bg-blob-pink);
  animation: aurora-drift-pink var(--aurora-bg-duration-pink) var(--aurora-bg-easing) infinite;
}
.aurora-bg > .aurora-bg-blob--yellow {
  background: var(--aurora-bg-blob-yellow);
  animation: aurora-drift-yellow var(--aurora-bg-duration-yellow) var(--aurora-bg-easing) infinite;
  animation-delay: -8s;
}
.aurora-bg > .aurora-bg-blob--blue {
  background: var(--aurora-bg-blob-blue);
  animation: aurora-drift-blue var(--aurora-bg-duration-blue) var(--aurora-bg-easing) infinite;
  animation-delay: -14s;
}

/* Apply the blue blob to body via a pseudo-root trick so all three show globally */
#root::before {
  content: "";
  position: fixed;
  top: 50%;
  left: 50%;
  width: var(--aurora-bg-blob-size);
  height: var(--aurora-bg-blob-size);
  border-radius: 50%;
  filter: blur(var(--aurora-bg-blob-blur));
  opacity: var(--aurora-bg-blob-opacity);
  background: var(--aurora-bg-blob-blue);
  animation: aurora-drift-blue var(--aurora-bg-duration-blue) var(--aurora-bg-easing) infinite;
  animation-delay: -14s;
  pointer-events: none;
  z-index: -1;
}

/* Gentle, slow drift paths — each blob loops on its own orbit.
   translate(-50%, -50%) keeps the blob centered before the drift. */
@keyframes aurora-drift-pink {
  0%   { transform: translate(-50%, -50%) translate(-30vw, -25vh); }
  33%  { transform: translate(-50%, -50%) translate( 20vw, -10vh); }
  66%  { transform: translate(-50%, -50%) translate( -5vw,  20vh); }
  100% { transform: translate(-50%, -50%) translate(-30vw, -25vh); }
}

@keyframes aurora-drift-yellow {
  0%   { transform: translate(-50%, -50%) translate( 25vw,  20vh); }
  33%  { transform: translate(-50%, -50%) translate(-20vw,  10vh); }
  66%  { transform: translate(-50%, -50%) translate( 10vw, -25vh); }
  100% { transform: translate(-50%, -50%) translate( 25vw,  20vh); }
}

@keyframes aurora-drift-blue {
  0%   { transform: translate(-50%, -50%) translate(  0vw,  25vh); }
  33%  { transform: translate(-50%, -50%) translate( 25vw, -15vh); }
  66%  { transform: translate(-50%, -50%) translate(-25vw,   5vh); }
  100% { transform: translate(-50%, -50%) translate(  0vw,  25vh); }
}

@media (prefers-reduced-motion: reduce) {
  body::before,
  body::after,
  #root::before,
  .aurora-bg-blob {
    animation: none !important;
  }
}
